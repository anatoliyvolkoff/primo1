{
  "name": "primo-nails-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --port=3000",
    "dev:mock": "VITE_MOCK_API=1 VITE_MEDUSA_BACKEND_URL=http://localhost:3000 vite --port=3000",
    "build": "vite build",
    "build:pages": "VITE_MEDUSA_BACKEND_URL=https://mock.invalid VITE_MEDUSA_PUBLISHABLE_KEY=pk_mock vite build --config vite.pages.config.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "seo:sitemap": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "@medusajs/js-sdk": "^2.13.6",
    "@sentry/react": "^10.55.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@tanstack/react-query": "^5.99.0",
    "libphonenumber-js": "^1.13.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
